{
  "name": "decrypte-marketing",
  "version": "1.0.0",
  "description": "Génère des carrousels TikTok qui décryptent le marketing derrière la culture pop : recherche sourcée, rédaction, rendu 1080×1920 et envoi en brouillon.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "decrypte": "src/cli.js"
  },
  "scripts": {
    "studio": "node --watch-path=src src/studio/server.js",
    "studio:installer": "node src/cli.js studio-installer",
    "studio:desinstaller": "node src/cli.js studio-desinstaller",
    "veille": "node src/cli.js veille",
    "images": "node src/cli.js images",
    "verifier": "node src/cli.js verifier",
    "brouillon": "node src/cli.js brouillon",
    "publie": "node src/cli.js publie",
    "calendrier": "node src/cli.js calendrier",
    "tiktok:connexion": "node src/cli.js tiktok-connexion",
    "tiktok:verification": "node src/cli.js tiktok-verification",
    "setup:rembg": "python3 -m venv .venv && .venv/bin/pip install --quiet \"rembg[cli]\"",
    "test": "node --test \"tests/*.test.js\"",
    "demo:build": "node src/demo/build.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "sharp": "^0.34.4"
  }
}
