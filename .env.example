# Appli développeur TikTok (developers.tiktok.com > Manage apps)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Adresse de retour déclarée dans l'appli TikTok (Login Kit > Redirect URI)
TIKTOK_REDIRECT_URI=https://TON-COMPTE.github.io/decrypte-marketing/callback.html
# Racine du site GitHub Pages qui héberge les images (préfixe à vérifier dans le portail TikTok)
PAGES_BASE_URL=https://TON-COMPTE.github.io/decrypte-marketing/
